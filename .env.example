# FIMAR İK – ortam değişkenleri (üretimde bu değerleri kendi ortamınıza göre ayarlayın)
NODE_ENV=production
PORT=3000
# SQLite veritabanı dosyası (yedeklemeyi unutmayın)
DB_PATH=/data/fimar-ik.db
# İlk kurulumda oluşturulacak yönetici hesabı (ilk girişte şifre değişikliği zorunludur)
ADMIN_EMAIL=admin@fimar.com.tr
ADMIN_PASSWORD=GucluBirSifre2026
# Demo verisi yüklensin mi? Canlı kullanımda false olmalı.
SEED_DEMO=false
# Oturum süresi (gün)
SESSION_DAYS=7
# HTTPS arkasında çalışırken true (üretimde varsayılan true)
COOKIE_SECURE=true
# Ters vekil sunucu (nginx vb.) arkasındaysa true
TRUST_PROXY=true
